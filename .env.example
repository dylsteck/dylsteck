# Resend (https://resend.com) - Email subscriptions & newsletters
# Create an account, add a Segment in the dashboard, then copy the Segment ID
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_AUDIENCE_ID=your-segment-id-from-resend-dashboard

# Optional: Sender for newsletters (default: onboarding@resend.dev for testing)
# For production, use your verified domain e.g. newsletter@dylansteck.com
# RESEND_FROM=Dylan Steck <newsletter@dylansteck.com>

# Optional: App URL (default: https://dylansteck.com)
# NEXT_PUBLIC_URL=https://dylansteck.com
